# Confluence base URL, e.g.:
#   Cloud:           https://your-domain.atlassian.net/wiki
#   Server/DataCenter: https://confluence.your-company.com
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki

# --- Auth option 1: Confluence Cloud (email + API token) ---
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_EMAIL=you@company.com
CONFLUENCE_API_TOKEN=

# --- Auth option 2: Confluence Server / Data Center (Personal Access Token) ---
# Leave CONFLUENCE_EMAIL empty and set this instead to use Bearer auth.
CONFLUENCE_PAT=

# Set to "false" only if your corporate Confluence uses a self-signed/internal CA
# and you cannot install the CA cert locally. Prefer CONFLUENCE_CA_BUNDLE instead.
CONFLUENCE_VERIFY_SSL=true

# Optional: path to a custom CA bundle (.pem) for corporate proxies/internal CAs.
CONFLUENCE_CA_BUNDLE=
